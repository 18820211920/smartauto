# SmartAuto 后端环境配置
# Node.js + SQLite

NODE_ENV=production
PORT=3000

# 数据库（SQLite）
DB_PATH=./smartauto.db

# JWT密钥
JWT_SECRET=smartauto_jwt_secret_2026_lugong
JWT_EXPIRE=7d

# CORS
CORS_ORIGIN=*

# AI模型配置（至少配置一个）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
